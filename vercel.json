{
    "version": 2,
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "outputDirectory": "public",
    "functions": {
        "api/lambda.php": {
            "runtime": "vercel-php@0.5.0"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api/lambda.js"
        }
    ]
}
